{
  "name": "teawork-be",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env.development ./src/index.ts",
    "build": "tsc -p .",
    "type-check": "tsc --noEmit",
    "db-generate": "drizzle-kit generate",
    "env-dev": "DATABASE_URL=$(grep DATABASE_URL -w .env.development | cut -d '=' -f2- | cut -d '\"' -f2 )",
    "db-migrate-dev": "pnpm run env-dev drizzle-kit migrate",
    "db-push-dev": "pnpm run env-dev drizzle-kit push",
    "db-studio-dev": "pnpm run env-dev drizzle-kit studio --port=8003 --config=./drizzle.config.ts"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "drizzle-orm": "^0.41.0",
    "express": "~4.16.1",
    "express-rate-limit": "^7.4.0",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "jose": "^6.0.10",
    "morgan": "~1.9.1",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.2",
    "@typescript-eslint/parser": "^8.4.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  },
  "packageManager": "pnpm@10.6.3"
}
